#!/usr/bin/env python
import json
import re
import time
from datetime import datetime, timedelta
from urllib.parse import quote, urlencode
from uuid import uuid4

from html5_parser import parse
from lxml import etree
from mechanize import Request

from calibre import browser
from calibre.utils.date import local_tz
from calibre.web.feeds.news import BasicNewsRecipe


def safe_dict(data, *names):
    ans = data
    for x in names:
        ans = ans.get(x) or {}
    return ans


def process_web_list(li_node):
    li_html = ''
    for li in li_node['items']:
        if li.get('textHtml'):
            li_html += f'<li>{li["textHtml"]}</li>'
        elif li.get('textJson'):
            li_html += f'<li>{parse_textjson(li["textJson"])}</li>'
        else:
            li_html += f'<li>{li.get("text", "")}</li>'
    return '<ul>' + li_html + '</ul>'


def process_info_box(bx):
    info = ''
    for x in safe_dict(bx, 'components'):
        info += f'<blockquote>{process_web_node(x)}</blockquote>'
    return info


def parse_txt(ty):
    typ = ty.get('type', '')
    children = ty.get('children', [])
    href = '#'
    attributes = ty.get('attributes') or ()
    for a in attributes:
        if a.get('name') == 'href':
            href = a.get('value', href)
            break

    tag_map = {
        'text': lambda: [ty.get('value', '')],
        'scaps': lambda: [
            f'<span style="text-transform: uppercase; font-size: 0.85em; letter-spacing: 0.05em;">{"".join(parse_txt(c))}</span>' for c in children
        ],
        'bold': lambda: [f'<b>{"".join(parse_txt(c))}</b>' for c in children],
        'drop_caps': lambda: [f'<b>{"".join(parse_txt(c))}</b>' for c in children],
        'italic': lambda: [f'<i>{"".join(parse_txt(c))}</i>' for c in children],
        'linebreak': lambda: ['<br>'],
        'external_link': lambda: [f'<a href="{href}">{"".join(parse_txt(c))}</a>' for c in children],
        'internal_link': lambda: [f'<a href="{href}">{"".join(parse_txt(c))}</a>' for c in children],
        'ufinish': lambda: [text for c in children for text in parse_txt(c)],
        'subscript': lambda: [f'<sub>{"".join(parse_txt(c))}</sub>' for c in children],
        'superscript': lambda: [f'<sup>{"".join(parse_txt(c))}</sup>' for c in children],
    }

    if typ in tag_map:
        yield from tag_map[typ]()
    else:
        print('** ', typ)


def parse_textjson(nt):
    return ''.join(''.join(parse_txt(n)) for n in nt)


def process_web_node(node):
    ntype = node.get('type', '')
    if ntype == 'CROSSHEAD':
        if node.get('textHtml'):
            return f'<h4>{node.get("textHtml")}</h4>'
        return f'<h4>{node.get("text", "")}</h4>'
    elif ntype in ['PARAGRAPH', 'BOOK_INFO']:
        if node.get('textHtml'):
            return f'\n<p>{node.get("textHtml")}</p>'
        elif node.get('textJson'):
            return f'\n<p>{parse_textjson(node["textJson"])}</p>'
        return f'\n<p>{node.get("text", "")}</p>'
    elif (ntype == 'IMAGE') or (node.get('__typename', '') == 'ImageComponent'):
        alt = '' if node.get('altText') is None else node.get('altText')
        cap = ''
        if node.get('caption'):
            if node['caption'].get('textHtml') is not None:
                cap = node['caption']['textHtml']
            elif node['caption'].get('textJson') is not None:
                cap = parse_textjson(node['caption']['textJson'])
            elif node['caption'].get('text') is not None:
                cap = node['caption']['text']
        return f'<div><img src="{node["url"]}" title="{alt}"></div><div style="text-align:center; font-size:small;">{cap}</div>'
    elif ntype == 'PULL_QUOTE':
        if node.get('textHtml'):
            return f'<blockquote>{node.get("textHtml")}</blockquote>'
        elif node.get('textJson'):
            return f'<blockquote>{parse_textjson(node["textJson"])}</blockquote>'
        return f'<blockquote>{node.get("text", "")}</blockquote>'
    elif ntype == 'BLOCK_QUOTE':
        if node.get('textHtml'):
            return f'<blockquote><i>{node.get("textHtml")}</i></blockquote>'
        elif node.get('textJson'):
            return f'<blockquote><i>{parse_textjson(node["textJson"])}</i></blockquote>'
        return f'<blockquote><i>{node.get("text", "")}</i></blockquote>'
    elif ntype == 'DIVIDER':
        return '<hr>'
    elif ntype == 'INFOGRAPHIC':
        if node.get('fallback'):
            return process_web_node(node['fallback'])
    elif ntype == 'INFOBOX':
        return process_info_box(node)
    elif ntype == 'UNORDERED_LIST':
        if node.get('items'):
            return process_web_list(node)
    elif ntype:
        print('** ', ntype)
    return ''


def load_article_from_json(raw):
    body = ''
    try:
        data = json.loads(raw)['data']['findArticleByUrl']
    except Exception:
        try:
            data = json.loads(raw)['props']['pageProps']['cp2Content']
        except Exception:
            data = json.loads(raw)['props']['pageProps']['content']

    body += f'<div style="color: red; font-size:small; font-weight:bold;">{data.get("flyTitle", "")}</div>'
    body += f'<h1>{data["headline"]}</h1>'
    if data.get('rubric') and data.get('rubric') is not None:
        body += f'<div style="font-style: italic; color:#202020;">{data.get("rubric", "")}</div>'
    try:
        date = data['dateModified']
    except Exception:
        date = data['datePublished']
    dt = datetime.fromisoformat(date[:-1]) + timedelta(seconds=time.timezone)
    dt = dt.strftime('%b %d, %Y %I:%M %p')
    if data.get('dateline') is None:
        body += f'<p style="color: gray; font-size: small;">{dt}</p>'
    else:
        body += f'<p style="color: gray; font-size: small;">{dt + " | " + (data["dateline"])}</p>'
    main_image_url = safe_dict(data, 'leadComponent') or ''
    if main_image_url:
        body += process_web_node(data['leadComponent'])
    if data.get('byline'):
        if data['byline'] is not None:
            body += f'<p style="color: gray; font-size: small;"><i>{"By " + data["byline"]}</i></p>'
    for node in data.get('body'):
        body += process_web_node(node)
    return '<html><body><article>' + body + '</article></body></html>'


class NoArticles(Exception):
    pass


def get_content(url):
    """获取页面内容，模拟移动端浏览器"""
    headers = {
        'user-agent': 'Mozilla/5.0 (Linux; Android 16) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/150.0.7871.124 Mobile Safari/537.36 Liskov',
        'accept': 'text/html,application/xhtml+xml,application/xml;q=0.9,image/avif,image/webp,image/apng,*/*;q=0.8,application/signed-exchange;v=b3;q=0.7',
        'accept-language': 'en-US,en;q=0.9',
        'x-requested-with': 'com.economist.lamarr',
        'blaize_session': str(uuid4()),
        'sec-ch-ua-mobile': '?1',
        'sec-ch-ua-platform': 'Android',
        'sec-fetch-dest': 'document',
        'sec-fetch-mode': 'navigate',
        'sec-fetch-site': 'cross-site',
        'upgrade-insecure-requests': '1',
    }
    br = browser()
    req = Request(
        url + '?app=core%2Cfocused&no-chrome=key&no-adverts=key&webview=liskov',
        headers=headers,
    )
    res = br.open(req)
    return res.read()


def process_url(url):
    if url.startswith('/'):
        url = 'https://www.economist.com' + url
    return url


class Economist(BasicNewsRecipe):
    title = 'The Economist'
    language = 'en_GB'
    encoding = 'utf-8'
    masthead_url = 'https://www.livemint.com/lm-img/dev/economist-logo-oneline.png'

    __author__ = 'Kovid Goyal, unkn0wn'
    description = 'Global news and current affairs from a European perspective.'
    extra_css = '''
        em { color:#202020; }
        img {display:block; margin:0 auto; max-width:100%;}
        .article-notice { 
            color: #8B0000; 
            font-style: italic; 
            padding: 15px; 
            background: #f5f5f5; 
            border-left: 4px solid #8B0000;
            margin: 20px 0;
        }
        .article-link { 
            color: #0055A4; 
            text-decoration: none;
        }
        .article-link:hover { text-decoration: underline; }
        .section-header { 
            font-size: 1.4em; 
            font-weight: bold; 
            color: #8B0000; 
            border-bottom: 2px solid #8B0000;
            padding-bottom: 5px;
            margin-top: 1.5em;
        }
        .article-item {
            border-bottom: 1px solid #e0e0e0;
            padding: 0.8em 0;
        }
        .article-item:last-child { border-bottom: none; }
        .article-title { font-size: 1.1em; font-weight: bold; }
        .article-summary { color: #555; font-size: 0.95em; margin: 0.3em 0; }
        .article-meta { color: #888; font-size: 0.85em; }
    '''

    resolve_internal_links = True
    delay = 2
    browser_type = 'webengine'
    articles_are_obfuscated = True
    
    recipe_specific_options = {
        'date': {
            'short': 'The date of the edition to download (YYYY-MM-DD format)',
            'long': 'For example, 2024-07-19',
        },
        'res': {
            'short': 'Image resolution',
            'default': '600',
        },
    }

    def get_browser(self, *args, **kwargs):
        self.last_used_ua = kwargs['user_agent'] = (
            'Mozilla/5.0 (Linux; Android 14) AppleWebKit/537.36 (KHTML, like Gecko) Chrome/127.0.6533.103 Mobile Safari/537.36 Liskov'
        )
        br = BasicNewsRecipe.get_browser(self, *args, **kwargs)
        return br

    def canonicalize_internal_url(self, url, is_link=True):
        if url.endswith('/print'):
            url = url.rpartition('/')[0]
        return BasicNewsRecipe.canonicalize_internal_url(self, url, is_link=is_link)

    def publication_date(self):
        edition_date = self.recipe_specific_options.get('date')
        if isinstance(edition_date, str):
            edition_date = edition_date.strip()
        if edition_date:
            return datetime.strptime(edition_date, '%Y-%m-%d').replace(tzinfo=local_tz)
        return datetime.now().replace(tzinfo=local_tz)

    def get_obfuscated_article(self, url):
        """获取文章内容（用于 print_version）"""
        try:
            data = get_content(url)
            return {'data': data, 'url': url}
        except Exception as e:
            self.log(f'Error fetching article {url}: {e}')
            return {'data': None, 'url': url}

    def economist_return_index(self, ans):
        if not ans:
            raise NoArticles(
                'Could not find any articles. The Economist may have changed their website format.'
            )
        return ans

    def parse_index(self):
        """解析索引页面"""
        edition_date = self.recipe_specific_options.get('date')
        if isinstance(edition_date, str):
            edition_date = edition_date.strip()
        
        if edition_date:
            url = 'https://www.economist.com/weeklyedition/' + edition_date
            self.timefmt = ' [' + edition_date + ']'
        else:
            url = 'https://www.economist.com/weeklyedition'
            edition_date = None
            self.timefmt = ''

        self.log(f'Fetching from: {url}')
        
        # 尝试从网页获取
        try:
            ans = self.economist_parse_index(url)
            if ans:
                return self.economist_return_index(ans)
        except Exception as e:
            self.log(f'Failed to get index from website: {e}')
        
        # 如果失败，尝试备用方法
        raise NoArticles('Could not fetch the edition. Please check your internet connection.')

    def economist_parse_index(self, url):
        """从网页解析索引"""
        # 获取页面内容
        html_content = get_content(url)
        soup = parse(html_content)
        
        # 查找 __NEXT_DATA__ 脚本
        script_tag = None
        for script in soup.findall('.//script'):
            if script.get('id') == '__NEXT_DATA__':
                script_tag = script
                break
        
        if script_tag is None:
            self.log('__NEXT_DATA__ not found, trying to parse HTML directly')
            return self._parse_html_directly(soup)
        
        data = json.loads(script_tag.text)
        content = safe_dict(data, 'props', 'pageProps', 'content')
        
        if not content:
            return self._parse_html_directly(soup)
        
        # 设置封面
        cover_url = safe_dict(content, 'cover', 'url')
        if cover_url:
            cover_url = cover_url.replace('SQ_', '').replace('_AS', '_AP')
            self.cover_url = cover_url.replace(
                'economist.com/',
                'economist.com/cdn-cgi/image/width=960,quality=80,format=auto/'
            )
            self.log(f'Cover: {self.cover_url}')
        
        # 设置描述
        self.description = content.get('headline', 'The Economist')
        
        # 设置时间格式
        issue_date = content.get('issueDate', '')
        if issue_date:
            self.timefmt = f' [{issue_date[:10]}]'
        
        # 提取文章
        components = content.get('components', [])
        feeds = []
        seen = set()
        
        for component in components:
            if component.get('type') == 'AD':
                continue
            if component.get('type') != 'COLLECTION':
                continue
            
            section_name = component.get('name', 'Unnamed Section')
            articles = []
            
            for article in component.get('articles', []):
                article_id = article.get('id')
                url_article = process_url(article.get('url', ''))
                headline = article.get('headline', '')
                
                if article_id in seen or not url_article or not headline:
                    continue
                seen.add(article_id)
                
                rubric = article.get('rubric', '')
                fly_title = article.get('flyTitle', '')
                description = rubric
                if fly_title and fly_title != section_name:
                    description = fly_title + (' :: ' + rubric if rubric else '')
                elif not description:
                    description = rubric
                
                articles.append({
                    'title': headline,
                    'url': url_article,
                    'description': description,
                    'date': article.get('datePublished', ''),
                })
            
            if articles:
                feeds.append((section_name, articles))
        
        if feeds:
            total = sum(len(a) for _, a in feeds)
            self.log(f'✅ Found {total} articles in {len(feeds)} sections')
        else:
            self.log('⚠️ No articles found in __NEXT_DATA__, trying HTML parsing')
            return self._parse_html_directly(soup)
        
        return feeds

    def _parse_html_directly(self, soup):
        """直接从 HTML 解析文章（备用方案）"""
        articles = []
        seen = set()
        
        # 查找所有文章链接
        for a in soup.findall('.//a'):
            href = a.get('href', '')
            if href and re.match(r'^/\d{4}/\d{2}/\d{2}/[a-z0-9-]+$', href):
                title = a.text
                if title and len(title.strip()) > 10:
                    url = process_url(href)
                    if url not in seen:
                        seen.add(url)
                        articles.append({
                            'title': title.strip(),
                            'url': url,
                            'description': '',
                        })
        
        if articles:
            self.log(f'✅ Found {len(articles)} articles via direct HTML parsing')
            return [('Articles', articles)]
        
        return []

    def preprocess_html(self, soup):
        """预处理文章 HTML"""
        width = self.recipe_specific_options.get('res', '600')
        for img in soup.findall('.//img'):
            src = img.get('src', '')
            if src and 'economist.com' in src and 'cdn-cgi' not in src:
                img.set('src', src.replace(
                    'economist.com/',
                    f'economist.com/cdn-cgi/image/width={width},quality=80,format=auto/'
                ))
        return soup

    def preprocess_raw_html(self, raw_html, url):
        """预处理原始 HTML"""
        # 交互式文章处理
        if '/interactive/' in url:
            # 尝试提取标题
            root = parse(raw_html)
            title = ''
            for h1 in root.findall('.//h1'):
                if h1.text:
                    title = h1.text
                    break
            
            return f'''<html>
                <body>
                    <article>
                        <h1>{title or 'Interactive Article'}</h1>
                        <div class="article-notice">
                            <p>📖 This is an interactive article that requires a web browser.</p>
                            <p>Please visit the original page to view the full interactive content:</p>
                            <p><a class="article-link" href="{url}">{url}</a></p>
                        </div>
                        <p><em>Downloaded by calibre from The Economist</em></p>
                    </article>
                </body>
            </html>'''
        
        # 正常文章处理
        try:
            root = parse(raw_html)
            script = None
            for s in root.findall('.//script'):
                if s.get('id') == '__NEXT_DATA__':
                    script = s
                    break
            
            if script is not None and script.text:
                html = load_article_from_json(script.text)
            else:
                # 尝试从页面直接提取内容
                html = self._extract_content_from_html(root, url)
            
            if not html:
                return raw_html
            
            # 清理 HTML
            root_parsed = parse(html)
            
            # 移除脚本和样式
            for x in root_parsed.findall('.//*'):
                if x.tag in ['script', 'style', 'noscript', 'source', 'meta']:
                    parent = x.getparent()
                    if parent is not None:
                        parent.remove(x)
            
            # 处理 small caps
            for x in root_parsed.findall('.//span[@data-caps="initial"]'):
                x.set('style', 'font-weight:bold;')
            
            for x in root_parsed.findall('.//small'):
                if x.text and len(x.text) == 0:
                    x.text = x.text.upper()
                    x.tag = 'span'
                    x.set('style', 'text-transform: uppercase; font-size: 0.85em; letter-spacing: 0.05em;')
            
            # 调整标题层级
            for h2 in root_parsed.findall('.//h2'):
                h2.tag = 'h4'
            
            # 处理图片说明
            for x in root_parsed.findall('.//figcaption'):
                x.set('style', 'text-align:center; font-size:small;')
            
            for x in root_parsed.findall('.//cite'):
                x.tag = 'blockquote'
                x.set('style', 'color:#404040;')
            
            raw = etree.tostring(root_parsed, encoding='unicode')
            return raw
            
        except Exception as e:
            self.log(f'Error processing article: {e}')
            return raw_html

    def _extract_content_from_html(self, root, url):
        """从 HTML 中提取文章内容"""
        content = ''
        title = ''
        
        # 提取标题
        for h1 in root.findall('.//h1'):
            if h1.text:
                title = h1.text
                break
        
        if not title:
            for meta in root.findall('.//meta[@property="og:title"]'):
                title = meta.get('content', '')
                break
        
        # 提取文章正文
        body = ''
        for article in root.findall('.//article'):
            for p in article.findall('.//p'):
                if p.text:
                    body += f'<p>{p.text}</p>'
            break
        
        if not body:
            for div in root.findall('.//div[@class*="article-body"]'):
                for p in div.findall('.//p'):
                    if p.text:
                        body += f'<p>{p.text}</p>'
                break
        
        if not body:
            for div in root.findall('.//div[@class*="content"]'):
                for p in div.findall('.//p'):
                    if p.text:
                        body += f'<p>{p.text}</p>'
                break
        
        if title or body:
            content = f'''<html>
                <body>
                    <article>
                        <h1>{title or 'Article'}</h1>
                        {body or '<p>Full article content is available only with a subscription.</p>'}
                        <p><em>Downloaded by calibre from The Economist</em></p>
                        <p><a href="{url}">View original article</a></p>
                    </article>
                </body>
            </html>'''
        
        return content

    def print_version(self, url):
        """获取打印版本"""
        try:
            result = self.get_obfuscated_article(url)
            if result and result.get('data'):
                from calibre.ptempfile import PersistentTemporaryFile
                pt = PersistentTemporaryFile('.html')
                pt.write(result['data'])
                pt.close()
                return 'file:///' + pt.name
        except Exception as e:
            self.log(f'Error getting article: {e}')
        return url
